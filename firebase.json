          "projectId": "bullcare",
          "appId": "1:1046112362504:android:55d0b838e1bdb3fddd31bd",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "bullcare",
          "configurations": {
            "android": "1:1046112362504:android:55d0b838e1bdb3fddd31bd",
            "ios": "1:1046112362504:ios:22ee6910fe847ecddd31bd",
